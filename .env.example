# Gemini (chatbot brain): https://aistudio.google.com/apikey
GEMINI_API_KEY=your_actual_key_here

# ElevenLabs (the bot's voice on calls): https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=your_elevenlabs_key
# Voice to use; copy a voice ID from https://elevenlabs.io/app/voice-library
ELEVENLABS_VOICE_ID=your_voice_id

# OpenAI Whisper (transcribes the provider): https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_key

# Twilio (places the phone call): https://console.twilio.com
# Numbers in +E.164 format, e.g. +14045551234. On a trial account the provider number
# must be added under Phone Numbers > Verified Caller IDs.
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=your_twilio_number
PROVIDER_PHONE_NUMBER=your_provider_number

# Optional: WhatsApp heads-up message before the call (Meta Cloud API):
# https://developers.facebook.com > your app > WhatsApp > API Setup.
# The provider must have messaged the WhatsApp number in the last 24 hours.
WHATSAPP_ACCESS_TOKEN=your_whatsapp_token
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
PROVIDER_WHATSAPP_NUMBER=your_provider_whatsapp_number

# Optional: set a fixed public URL for call audio instead of an automatic Cloudflare quick tunnel.
# PUBLIC_URL=https://example.trycloudflare.com
# MEDIA_STREAM_PORT=8080
